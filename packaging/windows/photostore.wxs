<?xml version="1.0" encoding="utf-8"?>
<!--
  PhotoStore MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build photostore.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc photostore.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\PhotoStore by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch PhotoStore" box. Installs a Start Menu shortcut, makes
  PhotoStore the owner of `.pcraft`, and offers it under "Open with" for PSD/PSB and the image
  formats it reads (without taking over the user's default app for them), plus photostore-cli.
  `msiexec /qn` still installs silently.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="PhotoStore"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="5C8D1E43-6A74-4F20-9B12-8E3A7D5C1B90"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="PhotoStore image editor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of PhotoStore is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="PhotoStoreIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PhotoStoreIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/akiyamasho/PhotoStore/releases" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/akiyamasho/PhotoStore/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/akiyamasho/PhotoStore/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="PhotoStore" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by PhotoStoreApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\PhotoStore" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="PhotoStore" Level="1">
      <ComponentGroupRef Id="PhotoStoreFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchPhotoStore"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through photostore.en-us.wxl. -->
    <Property Id="PhotoStoreVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="PhotoStore $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch PhotoStore" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#PhotoStoreExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchPhotoStore" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="PhotoStoreFiles" Directory="INSTALLFOLDER">
      <Component Id="PhotoStoreApp" Guid="B7F42C19-3E65-4A8D-91C0-6D2E5F8A4B73">
        <File Id="PhotoStoreExe" Source="$(var.BinDir)\photostore.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="PhotoStore"
              Description="PhotoStore image editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="PhotoStoreIcon.exe" IconIndex="0" />
        </File>

        <!-- .pcraft: PhotoStore's own format; PhotoStore is its default app. -->
        <ProgId Id="PhotoStore.Document" Description="PhotoStore Document" Icon="PhotoStoreExe" IconIndex="0">
          <Extension Id="pcraft" ContentType="application/x-photostore">
            <Verb Id="open" Command="Open" TargetFile="PhotoStoreExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- PSD/PSB and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="PhotoStore.PhotoshopDocument" Description="PSD Document" Icon="PhotoStoreExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\PhotoStore.PhotoshopDocument\shell\open\command" Value="&quot;[#PhotoStoreExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="PhotoStore.Image" Description="Image" Icon="PhotoStoreExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\PhotoStore.Image\shell\open\command" Value="&quot;[#PhotoStoreExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.psd\OpenWithProgids" Name="PhotoStore.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.psb\OpenWithProgids" Name="PhotoStore.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdn\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ora\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.png\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tif\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tiff\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.webp\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.gif\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.bmp\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tga\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.exr\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.hdr\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.avif\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.qoi\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ico\OpenWithProgids" Name="PhotoStore.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "photostore"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe" Name="FriendlyAppName" Value="PhotoStore" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\shell\open\command" Value="&quot;[#PhotoStoreExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".pcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".psd" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".psb" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".pdn" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".ora" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".tif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".tiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".webp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".gif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".bmp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".tga" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".exr" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".hdr" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".avif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".qoi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\photostore.exe\SupportedTypes" Name=".ico" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\photostore.exe" Value="[#PhotoStoreExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\PhotoStore" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="PhotoStoreCli">
        <File Id="PhotoStoreCliExe" Source="$(var.BinDir)\photostore-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
